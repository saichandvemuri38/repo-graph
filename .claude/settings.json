{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "mcp__codeatlas",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(pwsh -NoProfile -File .claude/scripts/atlas.ps1:*)",
      "Bash(pwsh -NoProfile -File .claude/scripts/work.ps1:*)",
      "Bash(pwsh -NoProfile -File .claude/scripts/precommit.ps1:*)",
      "Bash(pwsh -NoProfile -File .claude/scripts/doctor.ps1:*)",
      "Bash(git branch:*)",
      "Bash(pwsh -NoProfile -File .claude/scripts/run-tests.ps1:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/scripts/session-start.ps1"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/scripts/on-edit.ps1"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/scripts/pre-edit.ps1"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
