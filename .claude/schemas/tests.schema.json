{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "How to run tests (config/tests.json)",
  "type": "object",
  "required": [
    "schemaVersion",
    "runners"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "runners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "languages",
          "detect",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "detect": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "unless": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
