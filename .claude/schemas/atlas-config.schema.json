{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeAtlas config (config/atlas.json and config/atlas.local.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "engine": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "python": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "journalMaxLines": {
          "type": "integer",
          "minimum": 100
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": {
        "refreshOnSessionStart": {
          "type": "boolean"
        },
        "refreshOnEdit": {
          "type": "boolean"
        },
        "refreshOnCommit": {
          "type": "boolean"
        },
        "refreshOnPush": {
          "type": "boolean"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 5
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "journalTail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "properties": {
        "taintOnEdit": {
          "type": "boolean"
        },
        "taintOnPrecommit": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "onPush": {
          "type": "boolean"
        },
        "onFinish": {
          "type": "boolean"
        },
        "onCommit": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
