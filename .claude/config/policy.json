{
  "$schema": "../schemas/policy.schema.json",
  "schemaVersion": 1,
  "riskThresholds": {
    "medium": {
      "affected": 4,
      "flows": 2
    },
    "high": {
      "affected": 11,
      "flows": 4
    },
    "critical": {
      "affected": 31,
      "flows": 8
    }
  },
  "editGate": {
    "mode": "block",
    "blockAt": "CRITICAL",
    "warnAt": "HIGH",
    "cacheMinutes": 20,
    "skipPaths": [
      ".claude/",
      ".git/",
      "docs/",
      "node_modules/"
    ],
    "skipTests": true
  },
  "commit": {
    "requireTask": false,
    "blockOnRemovedStillReferenced": true,
    "maxSubjectLength": 72
  },
  "push": {
    "mode": "warn",
    "blockAt": "CRITICAL"
  }
}
